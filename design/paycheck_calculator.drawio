START

    INPUT hoursWorked
    INPUT hourlyRate

    IF hoursWorked > 40 THEN

        LET regularPay = 40 * hourlyRate
        LET overtimeHours = hoursWorked - 40
        LET overtimePay = overtimeHours * (hourlyRate * 1.5)
        LET totalPay = regularPay + overtimePay

    ELSE

        LET totalPay = hoursWorked * hourlyRate

    END IF

    OUTPUT totalPay

END
