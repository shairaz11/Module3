# Get the number of hours worked
hours_worked = float(input("Enter hours worked this week: "))

# Calculate paycheck
if hours_worked > 40:
    overtime_hours = hours_worked - 40
    paycheck = (40 * 20) + (overtime_hours * 30)
else:
    paycheck = hours_worked * 20

# Display result
print("Weekly paycheck: $", paycheck)
